# Copy to apps/api/.env and fill in. .env is git-ignored; never commit real values.
# Leave the DB_* lines out to use the local docker-compose database instead.

# Shared dev database (ask the team for the values)
DB_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# Required. Key that signs access tokens: base64 of at least 32 random bytes.
# Generate your own with: openssl rand -base64 32
JWT_SECRET=
