{
  "name": "nimbus",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=!desktop",
    "dev:desktop": "turbo run dev --filter=desktop",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
