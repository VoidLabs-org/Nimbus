# Copy to apps/api/.env and fill in. .env is git-ignored; never commit real values.
# Leave the DB_* lines out to use the local docker-compose database instead.

# Shared dev database (ask the team for the values)
DB_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# Required. Key that signs access tokens: base64 of at least 32 random bytes.
# Generate your own with: openssl rand -base64 32
JWT_SECRET=

# Optional. First admin User: created at startup when both are set and nobody has that email yet.
# .env is read as a Java .properties file, so write a backslash in the password as \\.
NIMBUS_ADMIN_EMAIL=
NIMBUS_ADMIN_PASSWORD=

# Optional. Enables "Continue with Google". Create an OAuth client (Web application) in Google Cloud console
# and add this authorized redirect URI: http://localhost:3000/api/auth/oauth2/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Enables "Continue with GitHub". Create an OAuth App in GitHub (Settings > Developer settings) and set
# its authorization callback URL to: http://localhost:3000/api/auth/oauth2/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. The address people open Nimbus at; providers redirect back to it. Defaults to http://localhost:3000.
# Set it wherever Nimbus is deployed, and register <PUBLIC_URL>/api/auth/oauth2/callback/google at Google and
# <PUBLIC_URL>/api/auth/oauth2/callback/github at GitHub.
PUBLIC_URL=
